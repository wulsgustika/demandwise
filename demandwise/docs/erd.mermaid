erDiagram
    users {
        integer id PK
        varchar username
        varchar password_hash
        varchar nama_usaha
        datetime dibuat_pada
    }
    kategori {
        integer id PK
        varchar nama
    }
    pemasok {
        integer id PK
        varchar nama
        varchar kontak
        integer lead_time_hari
    }
    produk {
        integer id PK
        varchar kode
        varchar nama
        integer kategori_id FK
        varchar satuan
        integer pemasok_id FK
        bigint harga_beli_terakhir
        bigint harga_jual
        integer umur_simpan_hari
        integer lead_time_hari
        boolean aktif
        boolean tunda_pesan
    }
    batch_stok {
        integer id PK
        integer produk_id FK
        date tgl_masuk
        date tgl_kedaluwarsa
        integer jumlah_awal
        integer jumlah_sisa
        bigint hpp_satuan
        varchar status
    }
    transaksi_penjualan {
        integer id PK
        date tanggal
        bigint total
        text catatan
    }
    detail_penjualan {
        integer id PK
        integer transaksi_id FK
        integer produk_id FK
        integer batch_id FK
        integer qty
        bigint harga_satuan
        bigint hpp_satuan
    }
    mutasi_stok {
        integer id PK
        date tanggal
        integer produk_id FK
        integer batch_id FK
        varchar jenis
        integer qty
        text keterangan
    }
    stock_opname {
        integer id PK
        date tanggal
        integer produk_id FK
        integer stok_sistem
        integer stok_fisik
        integer selisih
    }
    biaya_operasional {
        integer id PK
        date tanggal
        varchar kategori_biaya
        bigint jumlah
        text keterangan
    }
    writeoff {
        integer id PK
        date tanggal
        integer batch_id FK
        integer produk_id FK
        integer qty
        bigint hpp_satuan
        bigint total_rugi
    }
    hasil_prediksi {
        integer id PK
        integer produk_id FK
        date tanggal_target
        float qty_prediksi
        varchar model
        datetime dibuat_pada
    }
    event_musiman {
        integer id PK
        varchar nama
        date tgl_mulai
        date tgl_selesai
        varchar sumber
    }
    indeks_musim {
        integer id PK
        integer produk_id FK
        integer bulan
        float indeks
    }
    notifikasi {
        integer id PK
        varchar jenis
        varchar level
        varchar judul
        text pesan
        boolean dibaca
        datetime dibuat_pada
        varchar ref_tabel
        integer ref_id
    }
    rekomendasi_tindakan {
        integer id PK
        integer batch_id FK
        varchar jenis
        text detail
        bigint harga_diskon
        varchar status
        datetime dibuat_pada
    }
    koreksi_prediksi {
        integer id PK
        integer produk_id FK
        date tanggal_target
        float qty_koreksi
        text alasan
        datetime dibuat_pada
    }
    evaluasi_model {
        integer id PK
        integer produk_id FK
        varchar model
        varchar versi
        float mae
        float rmse
        float mape
        datetime dievaluasi_pada
    }
    pesanan_pembelian {
        integer id PK
        integer pemasok_id FK
        date tanggal
        varchar status
        date jadwal_kirim
        text catatan
    }
    detail_pesanan {
        integer id PK
        integer pesanan_id FK
        integer produk_id FK
        integer qty_rekomendasi
        integer qty_final
        bigint harga_beli
    }
    harga_jual {
        integer id PK
        integer produk_id FK
        bigint harga
        date berlaku_mulai
        varchar sumber
    }
    harga_pesaing {
        integer id PK
        integer produk_id FK
        varchar nama_pesaing
        bigint harga
        date tanggal
    }
    kategori ||--o{ produk : "kategori_id"
    pemasok ||--o{ produk : "pemasok_id"
    produk ||--o{ batch_stok : "produk_id"
    transaksi_penjualan ||--o{ detail_penjualan : "transaksi_id"
    produk ||--o{ detail_penjualan : "produk_id"
    batch_stok ||--o{ detail_penjualan : "batch_id"
    produk ||--o{ mutasi_stok : "produk_id"
    batch_stok ||--o{ mutasi_stok : "batch_id"
    produk ||--o{ stock_opname : "produk_id"
    batch_stok ||--o{ writeoff : "batch_id"
    produk ||--o{ writeoff : "produk_id"
    produk ||--o{ hasil_prediksi : "produk_id"
    produk ||--o{ indeks_musim : "produk_id"
    batch_stok ||--o{ rekomendasi_tindakan : "batch_id"
    produk ||--o{ koreksi_prediksi : "produk_id"
    produk ||--o{ evaluasi_model : "produk_id"
    pemasok ||--o{ pesanan_pembelian : "pemasok_id"
    pesanan_pembelian ||--o{ detail_pesanan : "pesanan_id"
    produk ||--o{ detail_pesanan : "produk_id"
    produk ||--o{ harga_jual : "produk_id"
    produk ||--o{ harga_pesaing : "produk_id"
